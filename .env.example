# Copy to .env (in the repo root) and fill in. No quotes, no spaces around "=".
# .env is gitignored. Real environment variables, if set, override this file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Minimum LLM fit score (0-100) for a job to appear in the digest. Default 70.
# SCORING_THRESHOLD=70

# Job-alert mailbox (IMAP, read-only). Gmail: host imap.gmail.com, an app password, folder = your label name.
# MAIL_HOST=imap.gmail.com
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FOLDER=fastHire-alerts
# Region for alert jobs whose location is unclear (IN or UAE). Default UAE.
# ALERTS_FALLBACK_REGION=UAE
